rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN' && getUserData().status == 'ACTIVE';
    }
    
    function isAgent() {
      return isAuthenticated() && getUserData().role == 'AGENT' && getUserData().status == 'ACTIVE';
    }
    
    function getUserId() {
      return request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Clients collection
    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow read, write: if isAuthenticated();
    }

    // Vehicle Documents collection
    match /vehicleDocuments/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // Activity Logs collection
    match /activityLogs/{logId} {
      allow read, create: if isAuthenticated();
      allow delete: if false; // Audit logs are immutable
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
  }
}
