# Automobile Consultancy Vehicle & Renewal Management System — Production Environment Variables
# Copy this file to .env.local and provide your Google Firebase project credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# =====================================================================
# RapidAPI Vehicle RC Verification Configuration
# (Server-side ONLY — NEVER prefix with NEXT_PUBLIC_)
# API: https://rapidapi.com/idfy-idfy-default/api/vehicle-rc-verification
# =====================================================================
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=vehicle-rc-verification.p.rapidapi.com
RAPIDAPI_MONTHLY_QUOTA=40

# =====================================================================
# Production Security & Demo Control
# Set to 'false' in production to disable demo auto-fill buttons and 
# enforce strict Google Firebase Authentication
# =====================================================================
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
